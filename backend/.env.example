# =============================================================================
# LEXIS Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running locally.
#   cp .env.example .env
#
# NEVER commit .env to Git — it is already in .gitignore.
# .env.example (this file) IS committed — it documents what vars are needed
# but contains no real secrets.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
# The environment name — controls log level, docs visibility, etc.
ENVIRONMENT=development

# A long random secret used for JWT signing and session security.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-secret

# ── JWT ───────────────────────────────────────────────────────────────────────
# How long tokens are valid. Change these only if you have a reason.
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300                   # OTP valid for 5 minutes
OTP_MAX_ATTEMPTS=3                    # Wrong guesses before OTP is cancelled
OTP_RATE_LIMIT_MAX=3                  # Max send-otp calls per phone per window
OTP_RATE_LIMIT_WINDOW_SECONDS=60      # Rate limit window in seconds

# ── MongoDB (Motor async driver) ─────────────────────────────────────────────
# Local dev: mongodb://localhost:27017
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=lexis

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local dev:   redis://localhost:6379/0
# Redis Cloud: redis://:<password>@<host>:<port>/0
REDIS_URL=redis://localhost:6379/0

# ── Qdrant Vector DB (RAG — Module 5) ────────────────────────────────────────
# Local Docker container: localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=legal_knowledge_base
QDRANT_API_KEY=

# ── CORS — Frontend Origin ───────────────────────────────────────────────────
# The exact URL the React frontend runs on. No trailing slash.
# Dev default (Vite): http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_ORIGIN=http://localhost:5173

# ── LLM (Gemini / OpenAI) ───────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL_DEV=gemini-3.6-flash
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL_DEV=gpt-4o-mini
OPENAI_MODEL_DEMO=gpt-4o

# ── Firebase Auth ─────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service_account.json
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# ── Vault / Storage ───────────────────────────────────────────────────────────
# Local filesystem path where uploaded vault documents are stored (dev only).
# In production, this will be replaced by cloud object storage.
VAULT_STORAGE_PATH=./vault_storage

# ── Scheduling ────────────────────────────────────────────────────────────────
# How often the deadline reminder job checks for upcoming deadlines (minutes).
NOTIFICATION_CHECK_INTERVAL_MINUTES=60

# ── Brevo Email Service (Email OTP & Transactional Emails) ───────────────────
# Brevo v3 Transactional Email REST API (https://api.brevo.com/v3/smtp/email)
# Get your REST API key from: https://app.brevo.com/settings/keys/api
# IMPORTANT: Use an API key (starts with xkeysib-), NOT an SMTP key (xsmtpsib-).
# Add and verify your sender email at: https://app.brevo.com/senders
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=LEXIS

